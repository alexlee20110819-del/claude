{
  "name": "queensland-lead-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Local-first lead management dashboard for Queensland website-development leads",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexlee20110819-del/claude.git"
  },
  "license": "ISC",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:site": "node tools/build-site.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "bundle:leads": "node scripts/bundle-leads.ts",
    "build:private": "vite build",
    "build:public": "node scripts/bundle-leads.ts --clear && tsc --noEmit && vite build",
    "verify:build": "node scripts/verify-build.ts",
    "serve:site": "node -e \"const h=require('node:http'),f=require('node:fs'),p=require('node:path');const T={html:'text/html',css:'text/css',js:'text/javascript',json:'application/json',svg:'image/svg+xml',png:'image/png',jpg:'image/jpeg',webp:'image/webp',avif:'image/avif',woff2:'font/woff2',xml:'application/xml',txt:'text/plain'};h.createServer((q,r)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u.endsWith('/'))u+='index.html';const fp=p.join('site',u);f.readFile(fp,(e,b)=>{if(e){r.writeHead(404);return r.end(f.readFileSync('site/404.html'))}r.writeHead(200,{'content-type':T[p.extname(fp).slice(1)]||'application/octet-stream'});r.end(b)})}).listen(4173,()=>console.log('http://localhost:4173'))\""
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
